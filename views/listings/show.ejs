<% layout('/layouts/boilerplate') -%>

    <body>
        <div class="row mt-3 mb-2">
            <div class="col-8 offset-3">
                <h3><%= singlelisting.title %></h3>
            </div>

            <div class="col-6 offset-3">
                <div class="show-listing-card">
                    <img src="<%= singlelisting.image.url %>" class="card-img-top show-listing-card-img" alt="listing_image">
                    <div class="card-body">
                        <div class="card-text">
                            
                            <h5><%= singlelisting.description %></h5    >
                            <b>Price: </b>&#8377; <%= singlelisting.price.toLocaleString("en-IN") %> /night <br>
                            <b>Location: </b><%= singlelisting.location %> <br>
                            <b>Country: </b><%= singlelisting.country %> <br>
                        </div>
                    </div>
                    <br>
                </div>
            </div>

            <div class="col-2 offset-3">
                <a href="/listings/<%= singlelisting._id %>/edit">
                    <button style="background-color: #be1414;" class="btn btn-dark w-100"><b>Edit</b></button>
                </a>
            </div>
            <div class="col-2  offset-1">
                <form method="post" action="/listings/<%= singlelisting._id %>?_method=DELETE">
                    <button style="background-color: #000000;" class="btn btn-dark w-100"><b>Delete</b></button>
                </form>
            </div>

            <div style="margin-top: 1rem;" class="col-8 offset-3">
                <hr>
                <h3>Leave a Review</h3>
                <form method="POST" action="/listings/<%= singlelisting._id %>/reviews" class="needs-validation"
                    novalidate mb-3">
                    <div class="mt-3 mb-3">
                        <label for="rating" class="form-label">Rating</label>
                        <input type="range" min="1" class="form-range" max="5" name="review[rating]" id="rating">
                    </div>
                    <div class="mt-3 mb-3">
                        <label for="comment" class="form-label">Comment</label>
                        <textarea name="review[comment]" id="comment" cols="20" rows="5" class="form-control"
                            required></textarea>
                        <div class="invalid-feedback">
                            Add your comment here.
                        </div>
                    </div>
                    <button class="btn btn-outline-dark">Submit</button>
                </form>
            </div>
        
            <div style="margin-top: 0.50rem;" class="col-8 offset-3">
                <hr>
                <h4>All Reviews</h4>
                <div class="row">
                    <% for(let review of singlelisting.reviews) { %>
                            <div class="card col-5 mb-2 ms-3">
                                <div class="card-body">
                                    <h6 class="card-title">Anonymous User</h6>
                                    <p class="card-text"><%= review.comment %></p>
                                    <p class="card-text">Rating: <%= review.rating %> stars</p>
                                </div>
                                <div class="col-5">
                                    <form method="post" action="/listings/<%= singlelisting._id %>/reviews/<%= review._id %>?_method=DELETE">
                                        <button style="background-color: #000000;" class="btn btn-dark w-100"><b>Delete</b></button>
                                    </form>
                                </div>
                            </div>
                    <% } %>
                </div>
            </div>
        </div>
    </body>