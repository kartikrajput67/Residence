<% layout('/layouts/boilerplate') -%>

<div class="listings-header">
    <div>
        <h2>Explore stays</h2>
        <p>Find your perfect place for your next getaway.</p>
    </div>
</div>

<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">

    <% for (let listing of allListings) { %>

        <div class="col">
            <div class="listing-card">

                <!-- Listing image -->
                <a href="/listings/<%= listing._id %>" class="listing-image-link">
                    <img
                        src="<%= listing.image.url %>"
                        class="listing-image"
                        alt="<%= listing.title %>"
                        loading="lazy"
                    >
                </a>

                <!-- Listing details -->
                <div class="listing-details">

                    <a href="/listings/<%= listing._id %>"
                        class="listing-title">
                        <%= listing.title %>
                    </a>

                    <p class="listing-price">
                        <strong>
                            ₹ <%= listing.price.toLocaleString("en-IN") %>
                        </strong>
                        <span>/ night</span>
                    </p>

                </div>

            </div>
        </div>

    <% } %>

</div>