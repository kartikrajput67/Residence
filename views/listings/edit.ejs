<% layout('/layouts/boilerplate') -%>

    <body>
        <br>
        <div class="row">
            <div class="col-8 offset-2">
                <h1>Edit Listing</h1>
                <form method="post" action="/listings/<%= editListing._id %>?_method=PUT" novalidate class="needs-validation">
                    <div class="mb-3">
                        <label for="title" class="form-label">Title</label>
                        <input id="title" class="form-control" name="listing[title]" value="<%= editListing.title %>"
                            type="text" required>
                        <div class="invalid-feedback">
                            Please provide a title.
                        </div>
                        <div class="valid-feedback">Title Looks good!</div>
                    </div>
                    <div class="mb-3">
                        <label for="listing_image" class="form-label">Image URL</label>
                        <input id="listing_image" class="form-control" name="listing[image][url]"
                            value="<%= editListing.image.url %>" type="text" required>
                        <div class="invalid-feedback">
                            Please provide an image URL.
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="description" class="form-label">Description</label>
                        <textarea id="description" class="form-control"
                            name="listing[description]" required><%= editListing.description %></textarea>
                        <div class="invalid-feedback">
                            Please provide a description.
                        </div>
                    </div>

                    <div class="row">
                        <div class="mb-3 col-md-4">
                            <label for="price" class="form-label">Price</label>
                            <input id="price" class="form-control" name="listing[price]"
                                value="<%= editListing.price %>" type="number" required>
                            <div class="invalid-feedback">
                                Please provide a price.
                            </div>
                        </div>
                        <div class="mb-3 col-md-8">
                            <label for="country" class="form-label">Country</label>
                            <input id="country" class="form-control" name="listing[country]"
                                value="<%= editListing.country %>" type="text" required>
                            <div class="invalid-feedback">
                                Please provide country name.
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="location" class="form-label">Location</label>
                        <input id="location" class="form-control" name="listing[location]"
                            value="<%= editListing.location %>" type="text" required>
                        <div class="invalid-feedback">
                            Please provide a location.
                        </div>
                    </div>

                    <button style="background-color: #be1414;" class="btn btn-dark">Submit</button>
                </form>
            </div>
        </div>
        <br>
                <!-- <script src="/JS/script.js"></script> -->
    </body>